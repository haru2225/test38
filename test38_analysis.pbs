#!/usr/bin/env bash
# Snapshot training weights, generate from training-scale noise, export XYZ, analyze.
# Usage: qsub -P <ProjectGroup_ID> test38_analysis.pbs
# Override CHECKPOINT_PATH, GENERATED_DIR, ANALYSIS_PATH and CGMD_PATH as needed.
#PBS -q sg8
#PBS -N test38_analysis
#PBS -l walltime=20:00:00
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=8:mem=32gb:ngpus=1
#PBS -j oe
set -euo pipefail

cd "${PBS_O_WORKDIR:-$(dirname "${BASH_SOURCE[0]}")}"
work_dir="$(pwd -P)"
runtime="${CONTAINER_RUNTIME:-singularity}"
if ! command -v "$runtime" >/dev/null 2>&1 && command -v apptainer >/dev/null 2>&1; then
    runtime=apptainer
fi
command -v "$runtime" >/dev/null 2>&1 || { echo 'Load singularity or apptainer first.' >&2; exit 2; }
sif="${SIF_IMAGE:-$work_dir/test38.sif}"
[[ -r "$sif" ]] || { echo "Missing SIF image: $sif" >&2; exit 2; }

dataset="${DATASET_PATH:-$work_dir/input/test36-dataset}"
if [[ -r "$dataset/positions.npy.part00" && -r "$dataset/positions.npy.part01" ]]; then
    part_bytes=$(( $(wc -c < "$dataset/positions.npy.part00") + $(wc -c < "$dataset/positions.npy.part01") ))
    if [[ ! -r "$dataset/positions.npy" || $(wc -c < "$dataset/positions.npy") -ne "$part_bytes" ]]; then
        cat "$dataset/positions.npy.part00" "$dataset/positions.npy.part01" > "$dataset/positions.npy"
    fi
fi
checkpoint="${CHECKPOINT_PATH:-${TRAIN_DIR:-$work_dir/results/train}/checkpoint.pt}"
if [[ -z "${CHECKPOINT_PATH:-}" && -z "${TRAIN_DIR:-}" && ! -r "$checkpoint" && -r "$work_dir/train/checkpoint.pt" ]]; then
    checkpoint="$work_dir/train/checkpoint.pt"
fi
[[ -r "$dataset/metadata.json" && -r "$dataset/positions.npy" && -r "$dataset/cells.npy" ]] || { echo "Incomplete dataset: $dataset" >&2; exit 2; }
[[ -r "$checkpoint" ]] || { echo "Missing checkpoint: $checkpoint" >&2; exit 2; }

# Each submission has its own immutable checkpoint and output directory.
# test38 saves training checkpoints by atomic rename, so copying the opened
# file remains consistent even when training replaces checkpoint.pt meanwhile.
mkdir -p "$work_dir/results/intermediate"
run_dir="$(mktemp -d "$work_dir/results/intermediate/run.XXXXXXXX")"
snapshot="$run_dir/checkpoint.pt"
cp "$checkpoint" "$snapshot"
generated="${GENERATED_DIR:-$run_dir/generated}"
analysis="${ANALYSIS_PATH:-$run_dir/analysis.json}"
echo "Source checkpoint: $checkpoint"
echo "Snapshot and results: $run_dir"

bind_args=(--bind "$work_dir:$work_dir")
if [[ -n "${EXTRA_BIND:-}" ]]; then bind_args+=(--bind "$EXTRA_BIND"); fi
run_python() {
    "$runtime" exec --nv "${bind_args[@]}" \
        --env OMP_NUM_THREADS=8 --env MKL_NUM_THREADS=8 --pwd "$work_dir" \
        "$sif" python -u "$@"
}
generation_status=0
run_python "$work_dir/test38.py" generate --checkpoint "$snapshot" \
    --output "$generated" --device cuda \
    --initial-state "${INITIAL_STATE:-rattled}" \
    --reverse-steps "${REVERSE_STEPS:-300}" --deterministic-steps "${DETERMINISTIC_STEPS:-30}" \
    --start-sigma "${START_SIGMA:-0.75}" --sigma-min "${SIGMA_MIN:-0.001}" \
    --thermal-scale "${THERMAL_SCALE:-1}" --seed "${SEED:-1337}" \
    --checkpoint-every "${CHECKPOINT_EVERY:-25}" \
    --time-budget-hours "${GENERATE_TIME_HOURS:-18}" || generation_status=$?
if [[ "$generation_status" -ne 0 && "$generation_status" -ne 75 ]]; then
    echo "Generation failed (exit $generation_status); inspect the job log." >&2
    exit "$generation_status"
fi
run_python "$work_dir/export_test38_xyz.py" --generated "$generated"
args=(--reference "$dataset" --checkpoint "$snapshot" --generated "$generated" --output "$analysis"
      --max-frames "${MAX_FRAMES:-20}" --r-max "${R_MAX:-10}" --bins "${RDF_BINS:-100}")
if [[ -n "${CGMD_PATH:-}" ]]; then args+=(--cgmd "$CGMD_PATH"); fi

run_python "$work_dir/analyze_test38.py" "${args[@]}"
echo "Analysis saved: $analysis"
exit "$generation_status"
